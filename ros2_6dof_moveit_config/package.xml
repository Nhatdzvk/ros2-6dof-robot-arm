<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_6dof_moveit_config</name>
  <version>0.0.0</version>
  <description>Module cấu hình MoveIt 2 cho lập kế hoạch quỹ đạo cánh tay robot 6 DOF</description>
  <maintainer email="nhat@todo.todo">Nguyen Xuan Nhat</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Các thư viện cần thiết cho MoveIt 2 -->
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_kinematics</depend>
  <depend>moveit_planners_ompl</depend>
  <depend>ros2_6dof_description</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
